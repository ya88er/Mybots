# Dependencies
node_modules/
vendor/minimax-bot/tests/node_modules/

# Build output
dist/
release/
out/
*.tsbuildinfo

# The generated icons: they are made from the upstream skin by
# `scripts/make-icons.mjs`, so they are not committed.
build/icon.png
build/icon-64.png
build/tray-icon.png

# The verification reports
package-verification-report.txt
package-verification-report-launch.txt

# Electron runtime caches
.vite/
.cache/

# Secrets and credentials — never commit these
*.env
*.env.*
!.env.example
credentials.enc.json
*.key
*.pem
auth.json

# Personal application data (the app stores state under Electron userData, but
# never let a local copy leak into the repo)
userData/
*.log
logs/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Scratch commit-message files (written to disk because PowerShell mangles
# double quotes in `git commit -m`)
.git-commit-*.txt

# Scratch output from the Electron smoke tests (Electron on Windows does not
# write to the console, so the report goes to a file)
shell-smoke-report.txt
desktop-tests-report.txt
client-origin-probe.txt
dev-launch.log
dev-launch.err
.tmp-*

# The scratch directory for the packaging probes and their output
ops/
